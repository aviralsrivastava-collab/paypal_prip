FROM python:3.11-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app

WORKDIR /app

# Install security updates
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Create non-root system user
RUN groupadd -g 10001 appgroup && \
    useradd -u 10001 -g appgroup -s /bin/bash -m appuser

# Copy application code and configuration
COPY backend /app/backend
COPY contracts /app/contracts
COPY alembic.ini /app/alembic.ini

# Ensure non-root ownership
RUN chown -R appuser:appgroup /app

USER appuser

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "from backend.core.database import SessionLocal; from backend.repositories.worker_heartbeat import WorkerHeartbeatRepository; s=SessionLocal(); h=WorkerHeartbeatRepository(s).list_heartbeats(); s.close(); exit(0 if h else 1)" || exit 1

CMD ["python", "-m", "backend.worker"]
